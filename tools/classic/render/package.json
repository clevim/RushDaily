{
  "name": "rushdaily-classic-render",
  "private": true,
  "type": "module",
  "description": "Desenha as cartas clássicas em PT-BR com o yugioh-card (MIT) + skia-canvas (Node) ou Leafer (navegador).",
  "scripts": {
    "bundle": "esbuild entry.mjs --bundle --format=esm --platform=browser --minify --legal-comments=none --outfile=../../../src/vendor/yugioh-card/yugioh-card.js && node bundle-assets.mjs"
  },
  "dependencies": {
    "skia-canvas": "^2.0.2",
    "yugioh-card": "^1.9.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
